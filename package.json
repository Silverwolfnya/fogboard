{
  "name": "fogboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "雾榜 FogBoard — CCPC 2026 新赛制赛时榜单回放",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "build:single": "vite build --config vite.single.config.ts && node scripts/inline-single.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:team": "node scripts/verify-team.mjs",
    "verify:single": "node scripts/verify-single.mjs",
    "verify:background": "node scripts/verify-background.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/saira-condensed": "^5.2.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
